# Optional settings. Copy to .env.local and uncomment to override.
# No .env file is needed: the defaults below are what the project uses.

# Base URL of the SwimMatch JSON API.
# VITE_API_BASE=https://swimmatch.onrender.com

# Dev/preview port (read by vite.config.js). The API only accepts browser
# requests from http://localhost:5173, so change this only if the API allows
# the new origin as well.
# PORT=5173

# How long (milliseconds) a data request may take before the page shows a
# "timed out" message with a Try again button. Default 45000; the API can take
# ~30 s to wake up.
# VITE_API_TIMEOUT_MS=45000
